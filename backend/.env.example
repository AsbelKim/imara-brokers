PORT=3000

# Database — SQLite file lives at backend/db/imara.sqlite, created automatically on first run.
# No external service or credentials needed.

# JWT secret — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret

# Admin API key — generate with: node -e "console.log('ilf_admin_' + require('crypto').randomBytes(32).toString('hex'))"
# Use as: Authorization: Bearer <key>  on all /api/admin/* requests
ADMIN_API_KEY=replace_with_a_long_random_secret

# Allowed frontend origin (set to your domain in production)
FRONTEND_URL=http://localhost:5500

# OpenAI — used by the support chat bot (platform.openai.com → API keys)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
