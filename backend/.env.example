PORT=3000

# Database — SQLite file lives at backend/db/imara.sqlite, created automatically on first run.
# No external service or credentials needed.

# JWT secret — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret

# Admin API key — generate with: node -e "console.log('ilf_admin_' + require('crypto').randomBytes(32).toString('hex'))"
# Use as: Authorization: Bearer <key>  on all /api/admin/* requests
ADMIN_API_KEY=replace_with_a_long_random_secret

# Allowed frontend origin (set to your domain in production)
FRONTEND_URL=https://your-domain.com

# OpenAI — used for automatic KYC document verification and support chat
# Get your key at: platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Email (SMTP) — for password reset and transactional emails
# Leave blank to fall back to console.log (development mode)
# Recommended providers: Gmail, Mailgun, SendGrid, Resend
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="Imara Logic <noreply@imaralogic.co.ke>"
